{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@brawltome/accounts": ["./packages/modules/accounts/index.ts"],
      "@brawltome/foundation": ["./packages/foundation/index.ts"],
      "@brawltome/bhapi": ["./packages/bhapi/src/index.ts"],
      "@brawltome/telemetry": ["./packages/telemetry/src/index.ts"],
      "@brawltome/telemetry/node": ["./packages/telemetry/src/node.ts"],
      "@brawltome/player": ["./packages/modules/player/index.ts"],
      "@brawltome/clan": ["./packages/modules/clan/index.ts"],
      "@brawltome/discovery": ["./packages/modules/discovery/index.ts"],
      "@brawltome/ranking": ["./packages/modules/ranking/index.ts"],
      "@brawltome/request-admission": ["./packages/modules/request-admission/index.ts"],
      "@brawltome/refresh-operations": ["./packages/modules/refresh-operations/index.ts"],
      "@brawltome/replay-analysis": ["./packages/modules/replay-analysis/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
