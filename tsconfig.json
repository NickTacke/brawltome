{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@brawltome/accounts": ["./packages/contexts/accounts/index.ts"],
      "@brawltome/database": ["./packages/database/src/index.ts"],
      "@brawltome/bhapi": ["./packages/bhapi/src/index.ts"],
      "@brawltome/ui": ["./packages/ui/src/index.ts"],
      "@brawltome/shared": ["./packages/shared/src/index.ts"],
      "@brawltome/telemetry": ["./packages/telemetry/src/index.ts"],
      "@brawltome/telemetry/node": ["./packages/telemetry/src/node.ts"],
      "@brawltome/player": ["./packages/contexts/player/index.ts"],
      "@brawltome/clan": ["./packages/contexts/clan/index.ts"],
      "@brawltome/discovery": ["./packages/contexts/discovery/index.ts"],
      "@brawltome/matchmaking": ["./packages/contexts/matchmaking/index.ts"],
      "@brawltome/ranking": ["./packages/contexts/ranking/index.ts"],
      "@brawltome/request-admission": ["./packages/contexts/request-admission/index.ts"],
      "@brawltome/refresh-operations": ["./packages/contexts/refresh-operations/index.ts"],
      "@brawltome/identity": ["./packages/contexts/identity/index.ts"],
      "@brawltome/api/router": ["./apps/api/src/router/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
