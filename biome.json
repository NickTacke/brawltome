{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "apps/desktop/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useSemanticElements": "warn"
          },
          "correctness": { "noComponentHookFactories": "warn" },
          "suspicious": { "noArrayIndexKey": "warn" }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!**/.next",
      "!**/research",
      "!**/packages/game-data/src/generated",
      "!**/packages/contracts/openapi",
      "!**/apps/web/next-env.d.ts",
      "!**/apps/site/src/routeTree.gen.ts",
      "!**/apps/site/public",
      "!**/apps/desktop/app/gen",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  }
}
