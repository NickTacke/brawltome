[Unit]
Description=BrawlTome outbound replay bridge
After=network-online.target replay-processor.service
Wants=network-online.target
Requires=replay-processor.service

[Service]
Type=simple
User=replay-bridge
Group=replay-bridge
ExecStart=/opt/brawltome-replay-bridge/replay-bridge
Environment=BRAWLTOME_API_URL=https://api.brawltome.app
Environment=BRAWLTOME_REPLAY_BRIDGE_TOKEN_FILE=/etc/brawltome/replay-bridge-token
Environment=REPLAY_PROCESSOR_URL=http://127.0.0.1:8080
Environment=REPLAY_PROCESSOR_TOKEN_FILE=/etc/brawltome/replay-processor-token
Environment=REPLAY_BRIDGE_POLL_MS=2000
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
