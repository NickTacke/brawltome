# Database
DATABASE_URL=postgres://brawltome:brawltome@localhost:5432/brawltome

# Redis
REDIS_URL=redis://localhost:6379

# Brawlhalla API
BRAWLHALLA_API_KEY=

# Internal API secret (shared between API, web, and discord-bot)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Discord Bot
API_URL=http://localhost:3000
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Cloudflare Turnstile (discovery protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
CORS_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
PORT=3000

# Discord OAuth (create an app at https://discord.com/developers/applications)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_COOKIE_DOMAIN=
