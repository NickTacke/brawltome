# Database
DATABASE_URL=postgres://brawltome:brawltome@localhost:5432/brawltome

# Redis
REDIS_URL=redis://localhost:6379

# Brawlhalla API
BRAWLHALLA_API_KEY=

# Internal API secret (shared between API, web, and discord-bot)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Discord Bot
API_URL=http://localhost:3000
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Cloudflare Turnstile (discovery protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Anonymous refresh trust signing secret (generate independently with: openssl rand -hex 32)
REFRESH_TRUST_COOKIE_SECRET=

# Durable operations worker runtime policy
OPERATIONS_LEASE_MS=30000
OPERATIONS_POLL_MS=1000
OPERATIONS_RETRY_DELAY_MS=1000
OPERATIONS_SCHEDULE_BATCH_SIZE=100
OPERATIONS_TOTAL_CONCURRENCY=8
OPERATIONS_INTERACTIVE_RESERVATION=2
OPERATIONS_INTERACTIVE_CONCURRENCY=4
OPERATIONS_PRIMARY_MONITORING_CONCURRENCY=2
OPERATIONS_LEADERBOARD_CONCURRENCY=1
OPERATIONS_GLOBAL_STATISTICS_CONCURRENCY=1
OPERATIONS_PROJECTION_CONCURRENCY=2
OPERATIONS_MAINTENANCE_CONCURRENCY=1
OPERATIONS_PRIMARY_MONITORING_WEIGHT=8
OPERATIONS_LEADERBOARD_WEIGHT=4
OPERATIONS_GLOBAL_STATISTICS_WEIGHT=2
OPERATIONS_PROJECTION_WEIGHT=4
OPERATIONS_MAINTENANCE_WEIGHT=1

# Optional
AUTHENTICATED_REFRESH_IP_LIMIT=120
BRAWLHALLA_V1_REQUEST_LIMIT=180
CORS_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
PORT=3000
# Operations worker health server (set on that process only)
HEALTH_PORT=3001
# Validated graceful shutdown bounds
RUNTIME_SHUTDOWN_DEADLINE_MS=60000
RUNTIME_CLEANUP_RESERVE_MS=5000

# Discord OAuth (create an app at https://discord.com/developers/applications)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_COOKIE_DOMAIN=

# Steam OpenID (account linking)
STEAM_RETURN_URL=http://localhost:3000/auth/steam/callback
STEAM_REALM=http://localhost:3000

# Disable flags (set to 1 to disable)
DISABLE_VIEW_REFRESH=
DISABLE_JANITOR=
