# Database
DATABASE_URL=postgres://brawltome:brawltome@localhost:5432/brawltome

# Brawlhalla API
BRAWLHALLA_API_KEY=

# Internal API secret (shared between API, web, and discord-bot)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
# Dedicated Discord-to-API admission credential (generate separately).
DISCORD_INTERNAL_API_SECRET=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Discord Bot
API_URL=http://localhost:3000
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_METRICS_PORT=3002
# Optional smoke output path. Generated artifacts are ignored by git.
DISCORD_SMOKE_ARTIFACT_PATH=

# Cloudflare Turnstile (discovery protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Anonymous refresh trust signing secret (generate independently with: openssl rand -hex 32)
REFRESH_TRUST_COOKIE_SECRET=

# Dead-letter CLI operators. Use a dedicated least-privilege PostgreSQL role.
# Inject records at deployment and the raw high-entropy token only into the CLI process.
# Hash a generated token with: printf %s "$TOKEN" | shasum -a 256
DEAD_LETTER_DATABASE_URL=
DEAD_LETTER_OPERATOR_TOKENS=[{"actorId":"operator:replace-me","tokenSha256":"replace-with-64-lowercase-hex"}]
DEAD_LETTER_OPERATOR_TOKEN=

# Durable operations worker runtime policy
OPERATIONS_LEASE_MS=30000
OPERATIONS_POLL_MS=1000
OPERATIONS_RETRY_DELAY_MS=1000
OPERATIONS_SCHEDULE_BATCH_SIZE=100
OPERATIONS_TOTAL_CONCURRENCY=8
OPERATIONS_INTERACTIVE_RESERVATION=2
OPERATIONS_INTERACTIVE_CONCURRENCY=4
OPERATIONS_PRIMARY_MONITORING_CONCURRENCY=2
OPERATIONS_LEADERBOARD_CONCURRENCY=1
OPERATIONS_GLOBAL_STATISTICS_CONCURRENCY=1
OPERATIONS_PROJECTION_CONCURRENCY=2
OPERATIONS_MAINTENANCE_CONCURRENCY=1
OPERATIONS_PRIMARY_MONITORING_WEIGHT=8
OPERATIONS_LEADERBOARD_WEIGHT=4
OPERATIONS_GLOBAL_STATISTICS_WEIGHT=2
OPERATIONS_PROJECTION_WEIGHT=4
OPERATIONS_MAINTENANCE_WEIGHT=1
DISCOVERY_PROJECTION_BATCH_SIZE=500
DISCOVERY_RECONCILIATION_INTERVAL_MS=3600000
LEADERBOARD_PAGE_DEPTH=20
LEADERBOARD_INTERVAL_MS=900000

# Optional
AUTHENTICATED_REFRESH_IP_LIMIT=120
BRAWLHALLA_V1_REQUEST_LIMIT=1800
SOURCE_BACKGROUND_HEADROOM=30
SOURCE_UNAVAILABLE_RETRY_MS=60000
CORS_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
PORT=3000
# Operations worker health server (set on that process only)
HEALTH_PORT=3001
# Validated graceful shutdown bounds
RUNTIME_SHUTDOWN_DEADLINE_MS=60000
RUNTIME_CLEANUP_RESERVE_MS=5000

# Dedicated observability export (set on API, worker, web, and Discord in Dokploy)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_AUTHORIZATION=
TELEMETRY_BUFFER_CAPACITY=1000
TELEMETRY_DRAIN_INTERVAL_MS=1000
TELEMETRY_EXPORT_TIMEOUT_MS=250
TELEMETRY_TRACE_SAMPLE_RATE=0.1
DISCORD_METRICS_PORT=3002

# Observability deployment references. Values and files are owner-supplied at deployment.
BRAWLTOME_NETWORK_NAME=
DOKPLOY_NETWORK_NAME=dokploy-network
OBSERVABILITY_DATA_ROOT=
OBSERVABILITY_METRICS_QUOTA_BYTES=
OBSERVABILITY_LOGS_QUOTA_BYTES=
OBSERVABILITY_TRACES_QUOTA_BYTES=
PROMETHEUS_RETENTION_SIZE=
DISCORD_WEBHOOK_URL_FILE=
GRAFANA_ADMIN_PASSWORD_FILE=
METRICS_SCRAPE_SECRET=
METRICS_SCRAPE_SECRET_FILE=
OTEL_INGEST_TOKEN_FILE=

# Discord OAuth (create an app at https://discord.com/developers/applications)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_COOKIE_DOMAIN=

# Steam OpenID (account linking)
STEAM_RETURN_URL=http://localhost:3000/auth/steam/callback
STEAM_REALM=http://localhost:3000

# Disable flags (set to 1 to disable)
DISABLE_VIEW_REFRESH=
