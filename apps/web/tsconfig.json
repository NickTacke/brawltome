{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "preserve",
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@brawltome/api/router": ["../../apps/api/src/router/index.ts"],
      "@brawltome/identity": ["../../packages/contexts/identity/index.ts"],
      "@brawltome/shared": ["../../packages/shared/src/index.ts"],
      "@brawltome/database": ["../../packages/database/src/index.ts"]
    }
  },
  "include": ["src", "next-env.d.ts"],
  "exclude": ["node_modules", ".next"]
}
