{
  "name": "@brawltome/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/serve.ts",
    "./router": "./src/router/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/serve.ts",
    "dev:worker": "bun run --watch src/worker.ts",
    "build": "bun build src/serve.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brawltome/bhapi": "workspace:*",
    "@brawltome/database": "workspace:*",
    "@brawltome/shared": "workspace:*",
    "@hono/trpc-server": "^0.3.0",
    "@trpc/server": "^11.0.0",
    "hono": "^4.7.0",
    "ioredis": "^5.8.0",
    "superjson": "^2.2.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
