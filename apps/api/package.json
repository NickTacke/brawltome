{
  "name": "@brawltome/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/serve.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/serve.ts",
    "dev:operations-worker": "bun run --watch src/operations-worker.ts",
    "build": "bun build src/serve.ts src/operations-worker.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brawltome/accounts": "workspace:*",
    "@brawltome/bhapi": "workspace:*",
    "@brawltome/clan": "workspace:*",
    "@brawltome/contracts": "workspace:*",
    "@brawltome/discovery": "workspace:*",
    "@brawltome/foundation": "workspace:*",
    "@brawltome/game-data": "workspace:*",
    "@brawltome/player": "workspace:*",
    "@brawltome/ranking": "workspace:*",
    "@brawltome/request-admission": "workspace:*",
    "@brawltome/refresh-operations": "workspace:*",
    "@brawltome/replay-analysis": "workspace:*",
    "@brawltome/statistics": "workspace:*",
    "@brawltome/telemetry": "workspace:*",
    "@hono/trpc-server": "^0.3.0",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/zod": "1.16.2",
    "@trpc/server": "^11.25.0",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.17",
    "postgres": "^3.4.0",
    "superjson": "^2.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@orpc/client": "1.16.2",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
