{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // the export's checks also run these files unbundled, under node's type stripping and in a plain browser, which
    // need the extension on every import and only erasable typescript
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["."]
}
