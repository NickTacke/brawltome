{
  "components": {
    "parameters": {},
    "schemas": {
      "ContractProof": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "event": {
            "$ref": "#/components/schemas/ContractProofEvent"
          },
          "occurredAt": {
            "format": "date-time",
            "pattern": "Z$",
            "type": "string"
          },
          "optionalValue": {
            "type": "string"
          },
          "requiredNullable": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "count",
          "requiredNullable",
          "occurredAt",
          "event"
        ],
        "type": "object"
      },
      "ContractProofEvent": {
        "discriminator": {
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "attempt": {
                "format": "int32",
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "ready"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "attempt"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "failed"
                ],
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        ]
      }
    }
  },
  "info": {
    "title": "BrawlTome Internal Contracts",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/internal/contracts/proof": {
      "get": {
        "operationId": "getContractProof",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-secret",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractProof"
                }
              }
            },
            "description": "Canonical cross-language contract proof"
          }
        }
      }
    }
  }
}
